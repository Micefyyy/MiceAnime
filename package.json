{
  "name": "anime-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --host",
    "dev:backend": "cd backend && .\\venv\\Scripts\\python.exe -m uvicorn api:app --host 0.0.0.0 --port 8000",
